# Local development only. Production values come from SSM /evn-warp/app-env.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-at-least-32-characters"
AUTH_TRUST_HOST="true"
AUTH_URL="http://127.0.0.1:3000"
NEXTAUTH_URL="http://127.0.0.1:3000"
UPLOADS_DIR="/absolute/local/path/to/uploads"

# Optional integrations. Leave unset to disable the related feature.
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
BUILDUP_API_BASE_URL=""
WARP_LOOKUP_API_KEY=""
