# Copy values into .env or your deployment secret manager.
# Do not commit real credentials.

# CLEVER HQ mail pilot
# Disabled unless explicitly enabled.
CLEVER_HQ_MAIL_ENABLED="false"
# Dedicated MachineClient scope: mail.send
CLEVER_HQ_BASE_URL="http://127.0.0.1:3000"
CLEVER_HQ_AUTHORIZATION="Bearer <client_key>.<secret>"
CLEVER_HQ_INTERNAL_EMAIL_DOMAIN="evnsolution.com"

# WARP database target
# Runtime and manual HQ queue drain use the same selection order:
# TURSO_DATABASE_URL + TURSO_AUTH_TOKEN, then WARP_DB_PATH, then DATABASE_URL, then ./dev.db.
DATABASE_URL="file:./dev.db"
WARP_DB_PATH=""
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
